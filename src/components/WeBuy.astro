---
import card1 from '../images/buys/card1.jpg';
import card2 from '../images/buys/card2.jpg';
import card3 from '../images/buys/card3.jpg';
import card4 from '../images/buys/card4.jpg';
import card5 from '../images/buys/card5.jpg';
import card6 from '../images/buys/card6.jpg';
import card7 from '../images/buys/card7.jpg';
import card8 from '../images/buys/card8.jpg';
import card9 from '../images/buys/card9.jpg';
import card10 from '../images/buys/card10.jpg';
import card11 from '../images/buys/card11.jpg';
import card12 from '../images/buys/card12.jpg';
import card13 from '../images/buys/card13.jpg';

const cards = [
  {
    path: card1,
    alt: 'Platería',
    title: 'Platería',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card2,
    alt: 'Escultura',
    title: 'Esculturas',
    colSpan: '2',
    rowSpan: '2'
  },
  {
    path: card3,
    alt: 'Jarras de porcelana',
    title: 'Adornos de Vitrina / Cristalería',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card4,
    alt: 'Jarras de porcelana',
    title: 'Adornos de Vitrina / Cristalería',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card6,
    alt: 'Reloj antigüo',
    title: 'Relojes',
    colSpan: '1',
    rowSpan: '2'
  },
  {
    path: card5,
    alt: 'Jarrón de vidrio',
    title: 'Arte oriental',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card7,
    alt: 'Jarra de plata',
    title: 'Platería',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card8,
    alt: 'Juego de porcelana',
    title: 'Vajilla',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card13,
    alt: 'Misceláneo',
    title: 'Misceláneos',
    colSpan: '2',
    rowSpan: '1'
  },
  {
    path: card10,
    alt: 'Misceláneo',
    title: 'Misceláneos',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card11,
    alt: 'Misceláneo',
    title: 'Misceláneos',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card9,
    alt: 'Misceláneo',
    title: 'Misceláneos',
    colSpan: '1',
    rowSpan: '1'
  },
  {
    path: card12,
    alt: 'Misceláneo',
    title: 'Misceláneos',
    colSpan: '2',
    rowSpan: '2'
  },
];
---


<div class="we-buy-container">
  <div class="main-wrapper">
    <div class="text-container">
      <h3 class="text-center pb-5">Compramos</h3>
    </div>
    <div class="grid grid-cols-3 gap-2 max-w-6xl mx-auto p-4">
      {
        cards.map((item) => (
          <div class={`col-span-${item.colSpan} row-span-${item.rowSpan}`}>
            <img 
              src={item.path.src} 
              alt={item.alt} 
              class="w-full h-full object-cover rounded-lg"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>




<style>
  .we-buy-container {
    background: rgb(255,255,255);
/* background: linear-gradient(0deg, rgba(255,255,255,1) 30%, rgba(230,175,106,1) 100%, rgba(222,133,21,1) 100%); */
    padding: 140px 0;
  }
  .main-wrapper {
    width: 85%;
    margin: auto;
  }
  .text-container h3 {
    font-size: 40px;
    line-height: 40px;
    font-family: 'PoppinsMedium';
    margin-bottom: 0;
  }
</style>