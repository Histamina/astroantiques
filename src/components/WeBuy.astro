---
import card1 from '../images/buys/card1.jpg';
import card2 from '../images/buys/card2.jpg';
import card3 from '../images/buys/card3.jpg';
import card4 from '../images/buys/card4.jpg';
import card5 from '../images/card5.jpg';
import card6 from '../images/card6.jpg';
import card7 from '../images/card7.jpg';
import card8 from '../images/card8.jpg';
import card9 from '../images/card9.jpg';

const cards = [
  {
    path: card1,
    alt: 'Platería',
    title: 'Platería',
    colSpan: ''
  },
  {
    path: card2,
    alt: 'Escultura',
    title: 'Esculturas',
  },
  {
    path: card3,
    alt: 'Jarras de porcelana',
    title: 'Adornos de Vitrina / Cristalería'
  },
  {
    path: card4,
    alt: 'Jarras de porcelana',
    title: 'Adornos de Vitrina / Cristalería'
  },
  {
    path: card5,
    alt: 'Jarrón de vidrio',
    title: 'Arte oriental'
  },
  {
    path: card6,
    alt: 'Reloj antigüo',
    title: 'Relojes',
  },
  {
    path: card7,
    alt: 'Jarra de plata',
    title: 'Platería',
  },
  {
    path: card8,
    alt: 'Juego de porcelana',
    title: 'Vajilla',
  },
  {
    path: card9,
    alt: 'Misceláneo',
    title: 'Misceláneos',
  },
];
---


<div class="we-buy-container">
  <div class="main-wrapper">
    <div class="text-container">
      <h3 class="text-center pb-5">Compramos</h3>
    </div>
    <div class="grid grid-cols-3 gap-3">
    {
      cards.map((item) => (
        <div
          class="col-span-1 max-w-sm rounded overflow-hidden shadow-lg"
        >
          <div class="overflow-hidden">
            <img class="w-full h-full object-cover" src={item.path.src} alt={item.alt} />
          </div>
        </div>
        ))
    }  
    </div>
  </div>
</div>





<style>
  .we-buy-container {
    background: rgb(255,255,255);
/* background: linear-gradient(0deg, rgba(255,255,255,1) 30%, rgba(230,175,106,1) 100%, rgba(222,133,21,1) 100%); */
    padding: 140px 0;
  }
  .main-wrapper {
    width: 85%;
    margin: auto;
  }
  .text-container h3 {
    font-size: 40px;
    line-height: 40px;
    font-family: 'PoppinsMedium';
    margin-bottom: 0;
  }
</style>